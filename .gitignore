# Email autorizzate ad entrare da fuori casa e dettagli dell'account
# Cloudflare (server.py, Cloudflare Access). Dati personali di Fabio e
# Michela, non del codice: restano solo su questo PC.
access.json

# GLI ESTRATTI CONTO NON ENTRANO MAI QUI DENTRO.
# Contengono IBAN, numeri di carta e ogni movimento: una volta committati
# restano nella cronologia per sempre. Vale anche per export/anonimi/, che
# e' senza IBAN ma pieno di importi, date e negozi.
export/

# Rete di sicurezza: qualunque cosa somigli a un estratto conto lasciato
# per sbaglio nella radice.
conto*.csv
conto*.xls*
estratto*.csv
estratto*.xls*
movimenti*.csv
movimenti*.xls*
*_export.csv
*-export.csv

# Derivati: si rigenerano con `python bilancio.py`. Versionarli riempirebbe la
# cronologia di rumore a ogni elaborazione.
consolidato.csv
da_rivedere.csv
scartate.csv
dashboard.html
dashboard.xlsx

# Cache e residui
categorie_cache.json
__pycache__/
*.tmp
state.json

# Configurazione locale dell'IDE (JetBrains): niente a che fare col codice.
.idea/

# Il backup MoneyWiz pesa 1,8 MB ed e' gia' un archivio a se'.
backup/*.zip

# Il canvas di design: 2,2 MB di editor impacchettato, si rigenera dai
# sorgenti .dc.html che stanno accanto. I sorgenti si versionano, questo no.
design/layout-dashboard-bilancio.html

# Skill di terze parti installate con `npx skills add`: si reinstallano
# da skills-lock.json e non sono codice di questo progetto.
.agents/
.claude/


# Lo scratch del lavoro a task: ledger, brief e pacchetti di revisione.
# Si rigenera, e non racconta niente che git non sappia gia'.
.superpowers/
/docs/superpowers/
